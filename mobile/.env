# HTTPS backend URL for the production app. Expo inlines EXPO_PUBLIC_* at
# bundle time, so change this and rebuild before shipping.
EXPO_PUBLIC_API_URL=https://hupy-app-production.up.railway.app

# Google Sign-In OAuth client IDs (public identifiers, not secrets — they ship
# inside the app binary either way). Create all three in Google Cloud Console:
#
#   Web     — required to get an ID token at all; also the audience on Android
#   iOS     — bundle com.hupy.hupy; its REVERSED form goes in app.json's
#             `iosUrlScheme`, which is the one place this value is duplicated
#   Android — package com.hupy.hupy + the SHA-1 of BOTH signing keys
#             (debug keystore for `expo run:android`, and the EAS one from
#             `eas credentials` — miss the second and login works locally but
#             fails in TestFlight/Play builds)
#
# The backend must list all three in GOOGLE_CLIENT_IDS: the ID token's `aud`
# differs by platform, so a one-client allowlist rejects half your users.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=156810114249-m6j7ncfgm3p54rcrnljojkad53fdq61a.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=156810114249-lvsu6v2tath396b9a5f44v35bk3rlfff.apps.googleusercontent.com

# Where the published Privacy Policy and Terms of Use are hosted. App Review
# requires a working in-app privacy link for apps with account creation, and
# App Store Connect asks for the same URL. The documents are in landing/ —
# host them (GitHub Pages, Netlify, anywhere) and set these to the live URLs.
EXPO_PUBLIC_PRIVACY_URL=https://coderpepe.github.io/hupy-app/privacy.html
EXPO_PUBLIC_TERMS_URL=https://coderpepe.github.io/hupy-app/terms.html
