{
  "expo": {
    "name": "Hupy",
    "slug": "hupy",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hupy",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.hupy.hupy"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Hupy uses the microphone so you can practice speaking English with your AI tutor.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "com.hupy.hupy"
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "package": "com.hupy.hupy"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.156810114249-lvsu6v2tath396b9a5f44v35bk3rlfff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bddea073-ba95-4095-96c8-4d08f362f20b"
      }
    },
    "owner": "esophk",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bddea073-ba95-4095-96c8-4d08f362f20b"
    }
  }
}
