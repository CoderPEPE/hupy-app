# ---- Required --------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/hupy
# REQUIRED. Generate with `openssl rand -hex 32`. The server refuses to boot
# if this is shorter than 32 characters — a guessable signing key lets anyone
# mint a token for any account, so it is a hard failure rather than a warning.
# Left empty on purpose: a seeded placeholder is a secret published in git.
JWT_SECRET=

# REQUIRED when running the docker-compose stack: the Postgres password.
# Generate with `openssl rand -hex 32`. Compose refuses to start without it.
POSTGRES_PASSWORD=
OPENAI_API_KEY=sk-...

# ---- Optional: server ------------------------------------------------------
# PORT=3000
# Set to true ONLY when a proxy you control (Railway's edge, your own nginx)
# terminates connections. It makes the rate limiter key on the client address
# the proxy recorded instead of the socket peer — which behind a proxy is the
# proxy itself, collapsing every user into one shared bucket. Never set it
# when the process is reachable directly: the header is then client-supplied
# and anyone could mint unlimited buckets.
# TRUST_PROXY=false

# Optional: restrict CORS to a single origin (e.g. your web app's origin).
# Unset = allow all (fine for a native mobile app, which doesn't enforce CORS).
# CORS_ORIGIN=https://hupy.example.com

# ---- Optional: token lifetimes (seconds) -----------------------------------
# Access JWTs are short-lived; the client transparently refreshes them with
# the rotating refresh token (see /api/auth/refresh).
# ACCESS_TOKEN_TTL_SECS=900        # 15 minutes
# REFRESH_TOKEN_TTL_SECS=2592000   # 30 days

# ---- Optional: TTS tuning (defaults shown) ---------------------------------
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
# How many days a generated clip stays in the TTS cache before it is pruned
# on the next cache write (keeps the cache bounded).
TTS_CACHE_MAX_AGE_DAYS=30

# ---- Optional: rate-limit tuning (defaults shown) --------------------------
# Limits are per socket IP, in-memory sliding window, per process.
# AUTH_RATE_MAX=30
# AUTH_RATE_WINDOW_SECS=60
# TTS_RATE_MAX=120
# TTS_RATE_WINDOW_SECS=60
# WRITE_RATE_MAX=120
# WRITE_RATE_WINDOW_SECS=60

# ---- Optional: connection-pool tuning --------------------------------------
# DB_POOL_MAX_SIZE=10

# ---- Google Sign-In --------------------------------------------------------
# Every OAuth client ID that may appear as the `aud` of an ID token we accept:
# the web, iOS and Android clients of the mobile app. Comma-separated. Not
# secrets — client IDs ship inside the app binary. Unset disables Google login.
# GOOGLE_CLIENT_IDS=web-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com,android-id.apps.googleusercontent.com

# ---- Sign in with Apple ----------------------------------------------------
# Every `aud` an Apple identity token may carry — for the native iOS flow that
# is the app's bundle identifier. Comma-separated. Not secrets. Unset disables
# Sign in with Apple.
# APPLE_CLIENT_IDS=com.hupy.hupy
