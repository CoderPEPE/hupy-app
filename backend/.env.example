[TEMPLATE]
DATABASE_URL=postgres://localhost:5432/huppy
# Use a long random value (e.g. `openssl rand -hex 32`). A weak or default
# "change-me" secret logs a warning on boot.
JWT_SECRET=change-me
OPENAI_API_KEY=sk-...
PORT=3000
# Optional: restrict CORS to a single origin (e.g. your web app's origin).
# Unset = allow all (fine for a native mobile app, which doesn't enforce CORS).
# CORS_ORIGIN=https://huppy.example.com
# Optional TTS tuning (defaults shown)
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
