# ---- Required --------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/hupy
# Use a long random value (e.g. `openssl rand -hex 32`). A weak or default
# "change-me" secret logs a warning on boot.
JWT_SECRET=change-me
OPENAI_API_KEY=sk-...

# ---- Optional: server ------------------------------------------------------
# PORT=3000
# Optional: restrict CORS to a single origin (e.g. your web app's origin).
# Unset = allow all (fine for a native mobile app, which doesn't enforce CORS).
# CORS_ORIGIN=https://hupy.example.com

# ---- Optional: token lifetimes (seconds) -----------------------------------
# Access JWTs are short-lived; the client transparently refreshes them with
# the rotating refresh token (see /api/auth/refresh).
# ACCESS_TOKEN_TTL_SECS=900        # 15 minutes
# REFRESH_TOKEN_TTL_SECS=2592000   # 30 days

# ---- Optional: TTS tuning (defaults shown) ---------------------------------
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
# How many days a generated clip stays in the TTS cache before it is pruned
# on the next cache write (keeps the cache bounded).
TTS_CACHE_MAX_AGE_DAYS=30

# ---- Optional: rate-limit tuning (defaults shown) --------------------------
# Limits are per socket IP, in-memory sliding window, per process.
# AUTH_RATE_MAX=30
# AUTH_RATE_WINDOW_SECS=60
# TTS_RATE_MAX=120
# TTS_RATE_WINDOW_SECS=60
# WRITE_RATE_MAX=120
# WRITE_RATE_WINDOW_SECS=60

# ---- Optional: connection-pool tuning --------------------------------------
# DB_POOL_MAX_SIZE=10
